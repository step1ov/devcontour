    {
      "name": "task_retry",
      "description": "Explicitly retry a failed or cancelled task within the attempt budget. Diagnose the failure first.",
      "readOnly": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          }
        },
        "required": [
          "taskId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "task_assign",
      "description": "Assign a task to a team member. Assignment is not a distributed lease.",
      "readOnly": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
