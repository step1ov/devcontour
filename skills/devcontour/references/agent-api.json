                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 12000
                    },
                    "gate": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,80}$"
                    },
                    "scenario": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 1500
                    }
                  },
                  "required": [
                    "id",
                    "source",
                    "digest",
                    "text",
                    "gate",
                    "scenario"
                  ],
                  "additionalProperties": false
                }
              },
              "assignee": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.@-]{1,80}$"
              },
              "repositoryId": {
                "default": "main",
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "scope": {
                "default": "component",
                "type": "string",
                "enum": [
                  "component",
                  "workspace"
                ]
              },
              "relatedRepositories": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                }
              },
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 180
              },
              "description": {
                "type": "string",
                "minLength": 10,
                "maxLength": 12000
              },
              "role": {
                "type": "string",
                "enum": [
                  "architect",
                  "backend",
                  "frontend",
                  "qa"
                ]
              },
              "dependsOn": {
                "default": [],
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                }
              },
              "acceptance": {
                "minItems": 1,
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 1500
                }
              },
              "contracts": {
                "default": [],
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                }
              },
              "contextPacks": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                }
              },
              "writePaths": {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "resources": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                }
              },
              "finding": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "bug",
                      "debt"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 180
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "observation": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 3000
                  },
                  "consequence": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 1500
                  },
                  "reproduction": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3000
                  },
                  "fingerprint": {
                    "type": "string"
                  },
                  "sourceTaskId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  },
                  "sourceRunId": {
                    "type": "string"
                  },
                  "sourceSha": {
                    "type": "string"
                  },
                  "verification": {
                    "type": "string",
                    "const": "proposed"
                  }
                },
                "required": [
                  "kind",
                  "title",
                  "path",
                  "line",
                  "observation",
                  "consequence",
                  "reproduction",
                  "fingerprint",
                  "sourceTaskId",
                  "sourceRunId",
                  "sourceSha",
                  "verification"
                ]
              }
            },
            "required": [
              "title",
              "description",
              "role",
              "acceptance"
            ]
          }
        },
        "required": [
          "boardId",
          "task"
        ],
        "additionalProperties": false
      }
    },
