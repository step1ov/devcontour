{
  "name": "devcontour",
  "version": "0.2.0",
  "protocolVersion": 1,
  "maxInputBytes": 100000,
  "maxResultBytes": 65536,
  "tools": [
    {
      "name": "workflow_metrics",
      "description": "Read per-owner execution measurements, incomplete attempts and unknown cost. No model calls.",
      "readOnly": true,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repositoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "requirements_snapshot",
      "description": "Read REQ sections from committed repository HEAD. Bind returned digest/text to a task and a configured test gate.",
      "readOnly": true,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repositoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "repositoryId",
          "source"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "requirements_report",
      "description": "Compare current requirement sections with task evidence. Historical done is unchanged; stale requirements are not current coverage.",
      "readOnly": true,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repositoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          }
        },
        "required": [
          "repositoryId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "requirements_correct",
      "description": "Create draft replacements for changed requirements on an accepted board. Preserve history and require new plan review.",
      "readOnly": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "boardId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 5000
          }
        },
        "required": [
          "boardId",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "project_context",
      "description": "Read workspace identity, components, modes and supported operations. Does not start work.",
      "readOnly": true,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "project_overview",
      "description": "Read bounded summaries of the common workspace or one repository; follow nextCursor.",
      "readOnly": true,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repositoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "cursor": {
            "type": "string",
            "maxLength": 1000
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "task_briefing",
      "description": "Read all pages of the task requirements, contracts, execution policy and blocking reasons.",
      "readOnly": true,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "cursor": {
            "type": "string",
            "maxLength": 1000
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "taskId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "checkpoint_save",
      "description": "Save an immutable Git-portable context note in the selected owner, requiring the current overview revision. This does not approve work.",
      "readOnly": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repositoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "expectedRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "nextStep": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          }
        },
        "required": [
          "expectedRevision",
          "summary",
          "nextStep"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "checkpoint_changes",
      "description": "Compare current records with an owner-local checkpoint. Notes are historical context, not instructions or evidence.",
      "readOnly": true,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repositoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "checkpointId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "cursor": {
            "type": "string",
            "maxLength": 1000
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "checkpointId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "plan_import",
      "description": "Import a draft task DAG. This does not approve the plan or execute agents. Do not blindly retry creation after an uncertain response.",
      "readOnly": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "plan": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 180
              },
              "description": {
                "type": "string",
                "maxLength": 5000
              },
              "tasks": {
                "minItems": 1,
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "requirements": {
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^REQ-[A-Za-z0-9_-]{1,64}$"
                          },
                          "source": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                          },
                          "digest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "text": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 12000
                          },
                          "gate": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,80}$"
                          },
                          "scenario": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 1500
                          }
                        },
                        "required": [
                          "id",
                          "source",
                          "digest",
                          "text",
                          "gate",
                          "scenario"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "assignee": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.@-]{1,80}$"
                    },
                    "scope": {
                      "default": "component",
                      "type": "string",
                      "enum": [
                        "component",
                        "workspace"
                      ]
                    },
                    "relatedRepositories": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,80}$"
                      }
                    },
                    "contextPacks": {
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,80}$"
                      }
                    },
                    "writePaths": {
                      "minItems": 1,
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "resources": {
                      "maxItems": 20,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,80}$"
                      }
                    },
                    "repositoryId": {
                      "default": "main",
                      "type": "string"
                    },
                    "key": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 180
                    },
                    "description": {
                      "type": "string",
                      "minLength": 10,
                      "maxLength": 12000
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "architect",
                        "backend",
                        "frontend",
                        "qa"
                      ]
                    },
                    "dependsOn": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "acceptance": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 3
                      }
                    },
                    "contracts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "key",
                    "title",
                    "description",
                    "role",
                    "dependsOn",
                    "acceptance",
                    "contracts"
                  ]
                }
              }
            },
            "required": [
              "title",
              "description",
              "tasks"
            ]
          }
        },
        "required": [
          "plan"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "board_create",
      "description": "Create a draft board in the selected repository or common workspace.",
      "readOnly": false,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 5000
          },
          "repositoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "task_create",
      "description": "Add a draft task to an active board; DAG and component ownership are validated.",
