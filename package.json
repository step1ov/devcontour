{
  "name": "devcontour",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "devcontour": "lib/cli.js"
  },
  "files": [
    "lib",
    "dist",
    "packs",
    "templates",
    "skills",
    "docs",
    "design",
    "START.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "devcontour": "node --import tsx src/cli.ts",
    "dev": "node --import tsx src/cli.ts demo --dev",
    "start": "node --import tsx src/cli.ts serve",
    "demo": "node --import tsx src/cli.ts demo",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsc -p tsconfig.build.json && node scripts/build-skill.mjs && vite build",
    "check:skill": "node scripts/build-skill.mjs --check",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/smoke-package.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "node scripts/check-tokens.mjs",
    "check": "npm run lint && npm run build && npm test && npm run check:skill && node scripts/smoke-package.mjs && npm run test:e2e",
    "hooks:install": "node scripts/install-hooks.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "harness": "node --import tsx src/cli.ts",
    "test:evals": "node --import tsx src/cli.ts evals"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@xyflow/react": "12.11.6",
    "fast-xml-parser": "5.11.1",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "license": "MIT"
}
