{
  "name": "devcontour",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "devcontour": "lib/cli.js"
  },
  "files": [
    "lib",
    "dist",
    "packs",
    "templates",
    "skills",
    "docs",
    "todo/roadmap",
    "design",
    "START.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "devcontour": "node --import tsx src/cli.ts",
    "dev": "node --import tsx src/cli.ts demo --dev",
    "start": "node --import tsx src/cli.ts serve",
    "demo": "node --import tsx src/cli.ts demo",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:lib && node scripts/build-skill.mjs && vite build",
    "check:skill": "node scripts/build-skill.mjs --check",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/smoke-package.mjs",
    "test": "node --import tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "node scripts/check-tokens.mjs && eslint . --quiet",
    "check": "npm run lint && npm run build:lib && npm run check:skill && npm run build && npm test && node scripts/smoke-package.mjs && npm run test:e2e",
    "hooks:install": "node scripts/install-hooks.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:evals": "node --import tsx src/cli.ts evals",
    "lint:report": "eslint .",
    "test:live": "npm run build && node scripts/live-pilot.mjs",
    "build:lib": "npm run typecheck && tsc -p tsconfig.build.json",
    "test:live:isolation": "node --import tsx scripts/live-isolation.ts"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.77",
    "@modelcontextprotocol/server": "2.0.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "5.11.1",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  },
  "license": "MIT"
}
