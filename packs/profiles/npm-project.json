{
  "id": "npm-project",
  "version": "0.1.0",
  "capabilities": [
    "node",
    "npm",
    "unit-tests"
  ],
  "protectedPaths": [
    "package.json",
    "package-lock.json"
  ],
  "gates": [
    {
      "id": "install",
      "kind": "check",
      "command": [
        "npm",
        "ci"
      ],
      "timeoutMs": 600000
    },
    {
      "id": "unit-tests",
      "kind": "test",
      "command": [
        "npm",
        "test"
      ],
      "timeoutMs": 240000,
      "dependsOn": [
        "install"
      ],
      "report": {
        "type": "junit",
        "path": ".reports/junit.xml"
      }
    }
  ],
  "roles": {
    "developer": {
      "runtime": "claude",
      "title": "Разработчик",
      "requiresContract": false,
      "reviewer": {
        "runtime": "codex"
      }
    }
  },
  "contextPacks": [
    {
      "id": "technique-testing",
      "version": "1.0.0",
      "roles": [
        "backend",
        "engine",
        "qa",
        "qa-web",
        "qa-admin",
        "qa-mobile",
        "qa-api",
        "developer"
      ],
      "files": [
        ".agents/context/technique-testing.md"
      ],
      "references": [
        ".agents/context/vendor/matt-pocock/skills--engineering--tdd--SKILL.md",
        ".agents/context/vendor/matt-pocock/skills--engineering--tdd--tests.md",
        ".agents/context/vendor/matt-pocock/skills--engineering--tdd--mocking.md"
      ]
    }
  ]
}
