{
  "id": "react-native",
  "version": "0.3.0",
  "extends": [
    "node-checks",
    "mobile-maestro"
  ],
  "capabilities": [
    "react-native"
  ],
  "protectedPaths": [
    "app.json",
    "babel.config.js",
    "metro.config.js"
  ],
  "roles": {
    "mobile": {
      "runtime": "claude",
      "title": "Мобильный разработчик",
      "requiresContract": true,
      "reviewer": {
        "runtime": "codex"
      }
    },
    "qa-mobile": {
      "runtime": "codex",
      "title": "Тестировщик приложения",
      "reviewer": {
        "runtime": "claude"
      }
    }
  }
}
